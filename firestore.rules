rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Validate User Profile
    function isValidUser() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'name', 'theme', 'language', 'createdAt', 'updatedAt'])
        && data.theme in ['light', 'dark']
        && data.language in ['id', 'en']
        && data.email is string
        && data.name is string;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser() && request.resource.data.createdAt is number;
      allow update: if isOwner(userId) && request.resource.data.updatedAt is number;
    }
    
    match /users/{userId}/progress/training {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    match /users/{userId}/roleplays/{roleplayId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
  }
}
